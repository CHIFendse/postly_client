# Postly Windows release build
#
# Требования:
#   - Docker Desktop запущен
#   - доступ Docker к Docker Hub
#   - запускать команды из корня проекта
#
# Сборка образа:
#   docker build -f Dockerfile.win -t postly-win-builder .
#
# Извлечение готового exe:
#   docker create --name postly-win postly-win-builder
#   docker cp postly-win:/app/postly.exe ./build/bin/postly.exe
#   docker rm postly-win
#
# Результат:
#   build/bin/postly.exe
#
# Frontend встраивается в exe через go:embed.
# MinGW runtime линкуется статически.
# Для запуска Windows-приложения нужен системный Microsoft WebView2 Runtime.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"
ENV GOTOOLCHAIN=auto

RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf automake binutils-mingw-w64-x86-64 ca-certificates curl \
    gcc-mingw-w64-x86-64-posix git g++-mingw-w64-x86-64-posix libtool \
    libgtk-3-dev libwebkit2gtk-4.1-dev make nodejs npm pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fL --retry 8 --retry-delay 5 --retry-all-errors \
        --connect-timeout 30 --max-time 900 \
        -o /tmp/go.tar.gz \
        https://go.dev/dl/go1.25.0.linux-amd64.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm -f /tmp/go.tar.gz

ARG WAILS_VERSION=v3.0.0-alpha.86
RUN git clone --depth 1 --branch "${WAILS_VERSION}" \
        https://github.com/wailsapp/wails.git /tmp/wails \
    && cd /tmp/wails/v3 \
    && go install ./cmd/wails3 \
    && rm -rf /tmp/wails

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN wails3 generate bindings
RUN cd frontend && npm install && npm run build

ENV GOOS=windows
ENV GOARCH=amd64
ENV CGO_ENABLED=1
ENV CC=x86_64-w64-mingw32-gcc-posix
ENV CXX=x86_64-w64-mingw32-g++-posix
ENV CGO_LDFLAGS="-static-libgcc -static-libstdc++"

RUN wails3 generate icons -input build/appicon.png -windowsfilename build/appicon.ico
RUN wails3 generate syso -arch amd64 -icon build/appicon.ico -manifest build/windows/wails.exe.manifest -info build/windows/info.json

RUN go build -tags production -trimpath -buildvcs=false \
    -ldflags="-w -s -H windowsgui" -o postly.exe .