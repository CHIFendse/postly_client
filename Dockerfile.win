FROM golang:latest AS builder

# Устанавливаем кросс-компилятор для Windows
RUN apt-get update && apt-get install -y \
    build-essential gcc-mingw-w64-x86-64 nodejs npm

# Установка Wails (для подготовки инструментов)
RUN go install github.com/go-task/task/v3/cmd/task@latest &&

RUN git clone https://github.com/wailsapp/wails /tmp/wails && \
    cd /tmp/wails/v3 && \
    go build -o /usr/local/bin/wails ./cmd/wails && \
    rm -rf /tmp/wails

WORKDIR /app
COPY . .

# Сборка под Windows (CGO обязателен для Wails)
ENV CGO_ENABLED=1
ENV GOOS=windows
ENV GOARCH=amd64
ENV CC=x86_64-w64-mingw32-gcc

# Запускаем сборку
RUN task build