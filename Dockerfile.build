# ============================================================
# Postly — сборочный образ
# Собирает все релизные пакеты за один запуск:
#   Linux:   .deb  .rpm  .pkg.tar.zst
#   Windows: .exe  (кросс-компиляция с mingw-w64)
#   Opus статически вшит в оба бинарника.
#
# Использование (из корня проекта):
#   docker build -f Dockerfile.build -t postly-builder .
#   docker run --rm -v "$(pwd):/src" postly-builder
#
# Результаты → build/bin/
# ============================================================

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV GOPATH=/root/go
ENV PATH=$PATH:/usr/local/go/bin:/root/go/bin
# Автоматически скачать toolchain если go.mod требует новее установленного
ENV GOTOOLCHAIN=auto

# ── 1. Системные пакеты ─────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Базовые инструменты
    gcc g++ make pkg-config cmake git curl ca-certificates \
    # Linux: статическая линковка opus
    libopus-dev libopusfile-dev libogg-dev \
    # Linux: заголовки GTK3 + WebKitGTK 4.1 нужны для CGO-компиляции
    libgtk-3-dev libwebkit2gtk-4.1-dev \
    # Windows: кросс-компилятор
    gcc-mingw-w64-x86-64 g++-mingw-w64-x86-64 \
    && rm -rf /var/lib/apt/lists/*

# ── 2. Node.js 20 LTS ───────────────────────────────────────
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── 3. Go ───────────────────────────────────────────────────
RUN curl -fsSL https://dl.google.com/go/go1.24.4.linux-amd64.tar.gz \
    | tar -xz -C /usr/local

# ── 4. nfpm — упаковщик .deb / .rpm / .pkg.tar.zst ─────────
#    Не требует компиляции — берём готовый бинарник.
RUN curl -fsSL https://github.com/goreleaser/nfpm/releases/download/v2.46.3/nfpm_2.46.3_Linux_x86_64.tar.gz \
    | tar -xz -C /usr/local/bin nfpm \
    && chmod +x /usr/local/bin/nfpm

# ── 5. Сборка opus/ogg/opusfile для Windows (статика, mingw) ─
#    Слой кешируется — повторная сборка образа не перекомпилирует.
ENV WIN_OPUS=/win-opus
RUN mkdir -p ${WIN_OPUS}

RUN curl -fsSL https://downloads.xiph.org/releases/ogg/libogg-1.3.5.tar.gz | tar -xz \
    && cd libogg-1.3.5 \
    && ./configure --host=x86_64-w64-mingw32 \
        --enable-static --disable-shared --prefix=${WIN_OPUS} --quiet \
    && make -j$(nproc) install \
    && cd .. && rm -rf libogg-1.3.5

RUN curl -fsSL https://downloads.xiph.org/releases/opus/opus-1.5.2.tar.gz | tar -xz \
    && cd opus-1.5.2 \
    && ./configure --host=x86_64-w64-mingw32 \
        --enable-static --disable-shared --prefix=${WIN_OPUS} \
        --disable-extra-programs --disable-doc --quiet \
    && make -j$(nproc) install \
    && cd .. && rm -rf opus-1.5.2

RUN curl -fsSL https://downloads.xiph.org/releases/opus/opusfile-0.12.tar.gz | tar -xz \
    && cd opusfile-0.12 \
    && PKG_CONFIG_PATH=${WIN_OPUS}/lib/pkgconfig \
       ./configure --host=x86_64-w64-mingw32 \
           --enable-static --disable-shared --prefix=${WIN_OPUS} \
           --disable-http --quiet \
    && make -j$(nproc) install \
    && cd .. && rm -rf opusfile-0.12

# ── 6. Entrypoint ───────────────────────────────────────────
COPY build/docker-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /src
ENTRYPOINT ["/entrypoint.sh"]
